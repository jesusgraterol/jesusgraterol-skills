---
import {
  ArrowRight,
  BookOpen,
  Code,
  Eye,
  FilePenLine,
  GitCommitHorizontal,
  Play,
} from '@lucide/astro';

import { SKILL_ACCESS_LABELS, type ISkill } from '../../utilities/skill-catalog/index.ts';
import SkillIcon from '../skill-icon/skill-icon.astro';

interface Props {
  skill: ISkill;
}

// icon that signals what each kind of skill may change
const ACCESS_ICONS = {
  'changes-code': Code,
  'changes-code-and-pushes': Code,
  'commits-and-pushes': GitCommitHorizontal,
  'planning-files': FilePenLine,
  'read-only': Eye,
  'runs-picked-command': Play,
} as const;

const { skill } = Astro.props;
// explicit skills say what they may change; implicit skills say they load on their own and show a
// short summary, because their description is a long trigger list written for agents
const { BadgeIcon, badgeLabel, summary } =
  skill.kind === 'explicit'
    ? {
        BadgeIcon: ACCESS_ICONS[skill.access],
        badgeLabel: SKILL_ACCESS_LABELS[skill.access],
        summary: skill.description,
      }
    : { BadgeIcon: BookOpen, badgeLabel: 'Loads on its own', summary: skill.summary };
---

{/* the whole card is the link target, so the card draws the keyboard focus ring for it */}
<article
  class="group relative flex h-full flex-col rounded-xl border border-border bg-surface p-5 shadow-surface transition-colors hover:border-border-strong has-focus-visible:outline-2 has-focus-visible:outline-offset-3 has-focus-visible:outline-focus"
  data-skill-card
>
  <div class="flex items-center gap-3">
    <SkillIcon
      icon={skill.icon}
      size="card"
    />
    {/* the badge sits under the name so the pair balances the icon tile beside it */}
    <div class="min-w-0 flex-1">
      <h4 class="font-mono text-base font-bold wrap-anywhere">
        <a
          href={`/skills/${skill.name}/`}
          class="no-underline outline-none after:absolute after:inset-0 after:rounded-xl"
        >
          {skill.name}
        </a>
      </h4>
      <p
        class="flex items-center gap-1.5 text-xs font-semibold text-muted"
        data-skill-badge
      >
        <BadgeIcon
          class="size-3.5 shrink-0"
          aria-hidden="true"
        />
        {badgeLabel}
      </p>
    </div>
    <ArrowRight
      class="size-4 shrink-0 text-muted transition-colors group-hover:text-foreground"
      aria-hidden="true"
    />
  </div>
  <p
    class="mt-4 flex-1 text-sm leading-6 text-muted"
    data-skill-summary
  >
    {summary}
  </p>
</article>
