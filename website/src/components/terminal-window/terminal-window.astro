---
import CopyControl from '../copy-control/copy-control.astro';

interface Props {
  // copies the element with this id; context completes the copy button's accessible name
  copy?: { context: string; sourceId: string } | undefined;
  title: string;
}

const { copy, title } = Astro.props;
---

<figure
  class="overflow-hidden rounded-xl border border-border-strong bg-primary text-primary-foreground shadow-raised"
  data-terminal
>
  <figcaption
    class="grid min-h-11 grid-cols-[1fr_auto_1fr] items-center gap-3 border-b border-primary-foreground/15 py-1 pr-1 pl-4"
  >
    <span
      class="flex gap-1.5"
      aria-hidden="true"
    >
      <span class="size-2.5 rounded-full bg-primary-foreground/25"></span>
      <span class="size-2.5 rounded-full bg-primary-foreground/25"></span>
      <span class="size-2.5 rounded-full bg-primary-foreground/25"></span>
    </span>
    <span class="truncate font-mono text-xs text-primary-foreground/70">{title}</span>
    <span class="justify-self-end">
      {
        copy && (
          <CopyControl
            context={copy.context}
            label="Copy"
            sourceId={copy.sourceId}
          />
        )
      }
    </span>
  </figcaption>
  {
    copy && (
      <p
        class="border-b border-primary-foreground/15 px-4 py-2 text-xs leading-5 text-primary-foreground/80 sm:px-5"
        data-copy-hint={copy.sourceId}
        hidden
      />
    )
  }
  <div class="px-4 py-4 font-mono text-sm leading-6 sm:px-5">
    <slot />
  </div>
</figure>
