---
import TerminalWindow from '../terminal-window/terminal-window.astro';

interface Props {
  // what the command does, used to name its copy button, e.g. "install"
  action: string;
  command: string;
  id: string;
  label: string;
}

// tokens longer than this may break mid-token on narrow screens; shorter ones such as flags stay whole
const MAX_UNBROKEN_TOKEN_LENGTH = 16;
// shell prompt shown before the command but never copied
const SHELL_PROMPT = '$';

const { action, command, id, label } = Astro.props;
const tokens = command.split(' ');
---

<TerminalWindow
  copy={{ context: `${action} command`, sourceId: id }}
  title={label}
>
  <p class="flex gap-3">
    <span
      class="text-accent-on-primary select-none"
      aria-hidden="true"
      >{SHELL_PROMPT}</span
    >
    <code
      class="min-w-0 whitespace-pre-wrap"
      id={id}
      >{
        tokens.map((token, index) => (
          <>
            {index > 0 && ' '}
            <span
              class:list={[
                token.length > MAX_UNBROKEN_TOKEN_LENGTH ? 'wrap-anywhere' : 'whitespace-nowrap',
              ]}
            >
              {token}
            </span>
          </>
        ))
      }</code
    >
  </p>
</TerminalWindow>
