---
import { SITE_CONFIG } from '../../site.config.ts';
import BrandLogo from '../brand-logo/brand-logo.astro';
---

<footer class="border-t border-border py-12 sm:py-16">
  <div class="page-shell grid gap-10 sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto]">
    <div class="max-w-md">
      <BrandLogo />
      <p class="mt-4 text-sm leading-6 text-muted">
        Built and maintained by <a
          class="underline underline-offset-4"
          href={SITE_CONFIG.author.url}
          >{SITE_CONFIG.author.name}</a
        >. The skills put the <a
          class="underline underline-offset-4"
          href={SITE_CONFIG.agenticCodingUrl}
          >Agentic Coding</a
        > approach into practice.
      </p>
    </div>
    <nav
      class="grid content-start gap-2 text-sm"
      aria-label="Footer navigation"
    >
      <p class="mb-2 font-mono text-xs font-bold text-muted uppercase">Site</p>
      {SITE_CONFIG.navigation.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>
    <div class="grid min-w-52 content-start gap-2 text-sm text-muted">
      <p class="mb-2 font-mono text-xs font-bold uppercase">Project</p>
      <nav
        class="grid gap-2 text-foreground"
        aria-label="Project links"
      >
        <a
          href={SITE_CONFIG.repositoryUrl}
          target="_blank"
          rel="noreferrer"
          >Source repository</a
        >
        <a href="/llms.txt">llms.txt</a>
      </nav>
      <div class="mt-3 grid gap-1 border-t border-border pt-3 text-xs">
        <span>{SITE_CONFIG.url.replace('https://', '')}</span>
        <span>{SITE_CONFIG.license} License, © 2026</span>
      </div>
    </div>
  </div>
</footer>
