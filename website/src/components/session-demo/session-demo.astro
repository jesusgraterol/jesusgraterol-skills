---
import TerminalWindow from '../terminal-window/terminal-window.astro';

// who wrote one line of the session: the shell, the developer, or the coding agent
type ISessionSpeaker = 'agent' | 'shell' | 'you';

/*
 * A short, static terminal session: the developer discusses a change with the coding agent,
 * then turns it into a plan, reviews the result, and pushes it. Prompts are rendered from
 * expressions so formatters cannot drop them.
 */
const SESSION_LINES = [
  { speaker: 'shell', text: 'claude' },
  { speaker: 'you', text: "Let's rate-limit the public API per account." },
  { speaker: 'agent', text: 'Agreed. A sliding window per account in Redis fits your middleware.' },
  { speaker: 'you', text: '/jg-plan' },
  { speaker: 'agent', text: 'Plan saved. Approve it to start building.' },
  { speaker: 'you', text: '/jg-review' },
  { speaker: 'agent', text: 'Ready to commit' },
  { speaker: 'you', text: '/jg-push' },
  { speaker: 'agent', text: 'Pushed to main' },
] as const satisfies readonly { speaker: ISessionSpeaker; text: string }[];

// visible prompt and spoken label for each speaker
const SPEAKERS = {
  agent: { label: 'Agent', prompt: '' },
  shell: { label: 'Shell', prompt: '$' },
  you: { label: 'You', prompt: '>' },
} as const satisfies Record<ISessionSpeaker, { label: string; prompt: string }>;
---

<div data-session-demo>
  <TerminalWindow title="~/projects/acme-api">
    <ol
      class="grid gap-1"
      aria-label="Example session with a coding agent"
    >
      {
        SESSION_LINES.map(({ speaker, text }) => (
          <li
            class:list={[
              'flex gap-3 wrap-anywhere',
              speaker === 'you' && 'mt-3 first:mt-0',
              speaker === 'agent' && 'text-primary-foreground/70',
            ]}
            data-session-line={speaker}
          >
            <span class="sr-only">{`${SPEAKERS[speaker].label}: `}</span>
            <span
              class:list={[
                'flex h-6 w-3 shrink-0 items-center justify-center select-none',
                speaker === 'shell' ? 'text-accent-on-primary' : 'text-primary-foreground/50',
              ]}
              aria-hidden="true"
            >
              {speaker === 'agent' ? (
                <span class="size-1.5 rounded-full bg-accent-on-primary" />
              ) : (
                SPEAKERS[speaker].prompt
              )}
            </span>
            <span
              class:list={[
                text.startsWith('/') && 'font-bold text-accent-on-primary',
                speaker === 'shell' && 'text-primary-foreground',
              ]}
            >
              {text}
            </span>
          </li>
        ))
      }
    </ol>
  </TerminalWindow>
</div>
