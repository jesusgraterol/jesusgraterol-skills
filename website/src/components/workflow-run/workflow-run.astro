---
// one change from conversation to push; titles starting with a slash invoke a skill
const WORKFLOW_STEPS = [
  { isOptional: false, text: 'Talk the change through with your agent.', title: 'Discuss' },
  { isOptional: false, text: 'Save it as a plan you approve.', title: '/jg-plan' },
  { isOptional: true, text: 'Find gaps before you approve.', title: '/jg-challenge-plan' },
  { isOptional: true, text: 'Split a large plan into milestones.', title: '/jg-breakdown' },
  { isOptional: false, text: 'Approve, and the agent builds it.', title: 'Build' },
  { isOptional: false, text: 'Check the change before it ships.', title: '/jg-review' },
  { isOptional: false, text: 'Commit and push it.', title: '/jg-push' },
] as const;
---

<ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {
    WORKFLOW_STEPS.map(({ isOptional, text, title }, index) => (
      <li class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-4 shadow-surface">
        <div class="flex min-h-6 items-center justify-between gap-3">
          <span class="font-mono text-xs font-bold text-muted">
            {String(index + 1).padStart(2, '0')}
          </span>
          {isOptional && (
            <span class="rounded-full border border-border px-2 py-0.5 text-xs text-muted">
              Optional
            </span>
          )}
        </div>
        {title.startsWith('/') ? (
          <code class="font-mono text-sm font-bold text-accent">{title}</code>
        ) : (
          <span class="text-sm font-semibold">{title}</span>
        )}
        <p class="text-sm leading-6 text-muted">{text}</p>
      </li>
    ))
  }
</ol>
