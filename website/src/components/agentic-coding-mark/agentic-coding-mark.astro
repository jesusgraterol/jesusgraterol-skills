---
interface Props {
  // sizing and layout classes for the mark
  class?: string | undefined;
}

// the Agentic Coding site's mark; docs/asset-attribution.md records its origin
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
>
  <rect
    x="1"
    y="1"
    width="38"
    height="38"
    rx="10"
    class="fill-primary stroke-border-strong"
    stroke-width="1"
  ></rect>
  <path
    d="M16 11 8 20l8 9"
    class="stroke-primary-foreground"
    stroke-width="2.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path
    d="m24 11 8 9-8 9"
    class="stroke-accent-on-primary"
    stroke-width="2.75"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path
    d="m20 15.5 4.5 4.5-4.5 4.5-4.5-4.5 4.5-4.5Z"
    class="fill-chart-3"
  ></path>
</svg>
