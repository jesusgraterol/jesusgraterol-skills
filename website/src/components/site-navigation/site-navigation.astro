---
import { GitBranch, Menu } from '@lucide/astro';

import { SITE_CONFIG } from '../../site.config.ts';
import BrandLogo from '../brand-logo/brand-logo.astro';
import ExternalLink from '../external-link/external-link.astro';
import ThemeControl from '../theme-control/theme-control.astro';
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur-md">
  <div class="page-shell flex min-h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="min-w-0 no-underline"
      aria-label={`${SITE_CONFIG.name} home`}
    >
      <BrandLogo />
    </a>

    <nav
      class="hidden items-center gap-1 md:flex"
      aria-label="Primary navigation"
    >
      {
        SITE_CONFIG.navigation.map(({ href, label }) => (
          <a
            href={href}
            class="rounded-full px-3 py-2 text-sm font-medium text-muted no-underline transition-colors hover:bg-secondary hover:text-foreground"
          >
            {label}
          </a>
        ))
      }
      <a
        href={SITE_CONFIG.repositoryUrl}
        class="inline-flex size-9 items-center justify-center rounded-full text-muted no-underline transition-colors hover:bg-secondary hover:text-foreground"
        target="_blank"
        rel="noreferrer"
        aria-label="Source repository (opens in a new tab)"
        title="Source repository (opens in a new tab)"
      >
        <GitBranch
          class="size-4"
          aria-hidden="true"
        />
      </a>
      <ThemeControl />
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex size-10 list-none items-center justify-center rounded-full border border-border-strong marker:content-none"
        aria-label="Open navigation menu"
      >
        <Menu
          class="size-5"
          aria-hidden="true"
        />
      </summary>
      <div
        class="absolute right-0 mt-2 w-[min(19rem,calc(100vw-2rem))] rounded-xl border border-border bg-surface p-3 shadow-raised"
      >
        <nav
          class="grid gap-1"
          aria-label="Mobile navigation"
        >
          {
            SITE_CONFIG.navigation.map(({ href, label }) => (
              <a
                href={href}
                class="rounded-md px-3 py-2.5 text-sm font-semibold no-underline hover:bg-secondary"
              >
                {label}
              </a>
            ))
          }
          <ExternalLink
            class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-semibold no-underline hover:bg-secondary"
            href={SITE_CONFIG.repositoryUrl}
          >
            <GitBranch
              class="size-4"
              aria-hidden="true"
            />
            Source
          </ExternalLink>
        </nav>
        <div class="mt-3 border-t border-border pt-3">
          <ThemeControl />
        </div>
      </div>
    </details>
  </div>
</header>
